# SOC Engineering Copilot — environment variables
# Copy this file to `.env` and fill in values to enable the live LLM path.
# If unset, the app runs end-to-end using the deterministic mock LLM.

# OpenAI-compatible chat completion endpoint.
# Works with OpenAI, Together, Groq, vLLM, Ollama (with /v1 compat), etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local embedding model (sentence-transformers).
# Leave default unless you want to swap models.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Force the deterministic mock LLM even if OPENAI_API_KEY is set.
# Useful for reproducible demos and CI.
FORCE_MOCK_LLM=0
